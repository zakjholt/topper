{
  "name": "topper",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @topper/server --filter @topper/web dev",
    "db:migrate": "pnpm --filter @topper/server db:migrate",
    "db:push": "pnpm --filter @topper/server db:push",
    "e2e": "pnpm --filter @topper/server exec tsx scripts/e2e-play.ts",
    "build": "pnpm --filter @topper/shared build && pnpm --filter @topper/server build && pnpm --filter @topper/web build"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
